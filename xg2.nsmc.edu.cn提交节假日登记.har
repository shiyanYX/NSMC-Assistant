          "content": {
            "size": 6135,
            "mimeType": "application/javascript",
            "text": "\r\n//var href = window.location.href;\r\n//var web_url = href.split(\"SystemForm\")[0] + \"SystemForm/\"\r\n\r\nfunction setCity(obj)\r\n{\r\n    clearCity(obj);\r\n    var provinceCode = obj.value;\r\n    var str = obj.id;\r\n    var index = str.lastIndexOf('_');\r\n    var head = str.substring(0,index)+\"_\";\r\n    //alert(provinceCode);\r\n    //alert(head);\r\n    \r\n    //var areaData = document.getElementById(head+\"AreaData\").value;\r\n    //var areaData = document.getElementById(\"AreaData\").value;\r\n    //var areaData1 = document.getElementById(head + \"AreaData\").value;\r\n    //var areaData = document.getElementById(\"AreaData\").value;\r\n    //document.write(\"<script type='text/javascript' src='\" + web_url + areaData1 + \"'></script>\");\r\n\r\n    //var script = document.createElement(\"script\");\r\n    /*\r\n    script.type = \"text/javascript\";\r\n    script.src = web_url + areaData1;\r\n    document.getElementsByTagName('head')[0].appendChild(script);*///script.innerHTML();\r\n\r\n    //alert(web_url + areaData1);\r\n    var aCity = areaData.split(\",\");\r\n    var j = 1;\r\n    var provinceCode = provinceCode / 10000;\r\n    for (i = 1; i <= aCity.length; i++) {\r\n        if (aCity[i - 1].substring(0, 2) == provinceCode && aCity[i - 1].substring(2, 6) != \"0000\" && aCity[i - 1].substring(4, 6) == \"00\") {\r\n            document.getElementById(head + \"CityDdl\").options[j] = new Option(aCity[i - 1].substring(7, aCity[i - 1].length), aCity[i - 1].substring(0, 6));\r\n            j++;\r\n        }\r\n    }\r\n    if (parseInt(provinceCode) < 10)\r\n        provinceCode = \"0\" + provinceCode;\r\n    document.getElementById(head + \"ProvinceHid\").value = provinceCode + \"0000\";\r\n    document.getElementById(head+\"C2\").value = j;\r\n    document.getElementById(head + \"CityHid\").value = \"\";\r\n    clearArea(obj);\r\n}\r\n\r\nfunction setCounty(obj) {\r\n    var cityCode = obj.value;\r\n    var str = obj.id;\r\n    var index = str.lastIndexOf('_');\r\n    var head = str.substring(0, index) + \"_\";\r\n    //var areaData1 = document.getElementById(head + \"AreaData\").value;\r\n    //var areaData = document.getElementById(\"AreaData\").value;\r\n\r\n    /*var script = document.createElement(\"script\");\r\n  script.type = \"text/javascript\";\r\n  script.src = web_url + areaData1;\r\n  document.getElementsByTagName('head')[0].appendChild(script);*/\r\n    var aCity = areaData.split(\",\");\r\n    var j = 1;\r\n    var cityCode = cityCode / 100;\r\n    for (i = 1; i <= aCity.length; i++) {\r\n        if (aCity[i - 1].substring(0, 4) == cityCode && aCity[i - 1].substring(4, 6) != \"00\") {\r\n            document.getElementById(head + \"AreaDdl\").options[j] = new Option(aCity[i - 1].substring(7, aCity[i - 1].length), aCity[i - 1].substring(0, 6));\r\n            j++;\r\n        }\r\n    }\r\n    if (cityCode == \"0\") {\r\n        clearArea(obj);\r\n        document.getElementById(head + \"AreaDdl\").length = 0;\r\n        document.getElementById(head + \"CityHid\").value = \"\";\r\n        document.getElementById(head + \"C3\").value = 0;\r\n        document.getElementById(head + \"AreaHid\").value = \"\";\r\n    }\r\n    else {\r\n        if (parseInt(cityCode) < 1000)\r\n            cityCode = \"0\" + cityCode;\r\n        document.getElementById(head + \"AreaDdl\").length = j;\r\n        document.getElementById(head + \"CityHid\").value = cityCode + \"00\";\r\n        document.getElementById(head + \"C3\").value = j;\r\n        document.getElementById(head + \"AreaHid\").value = \"\";\r\n    }\r\n}\r\n\r\nfunction getArea() {\r\n    //document.getElementById(\"AreaDdl\").value = \"000000\";\r\n    //if (document.getElementById(\"province\").value != \"\") {\r\n    //    document.getElementById(\"area\").value = document.getElementById(\"province\").value;\r\n    //    document.getElementById(\"C1\").value = document.getElementById(\"province\").length;\r\n    //}\r\n    //if (document.getElementById(\"city\").value != \"\") {\r\n    //    document.getElementById(\"area\").value = document.getElementById(\"city\").value;\r\n    //    document.getElementById(\"C2\").value = document.getElementById(\"city\").length;\r\n    //}\r\n    //if (document.getElementById(\"county\").value != \"\") {\r\n    //    document.getElementById(\"area\").value = document.getElementById(\"county\").value;\r\n    //    document.getElementById(\"C3\").value = document.getElementById(\"county\").length;\r\n    //}\r\n    //var province = document.getElementById(\"province\");\r\n    //document.getElementById(\"A1\").value = province.options[province.selectedIndex].innerText;\r\n    //document.getElementById(\"C1\").value = province.options.length;\r\n    //var city = document.getElementById(\"city\");\r\n    //document.getElementById(\"A2\").value = city.options[city.selectedIndex].innerText;\r\n    //document.getElementById(\"C2\").value = city.options.length;\r\n    //var county = document.getElementById(\"county\");\r\n    //document.getElementById(\"A3\").value = county.options[county.selectedIndex].innerText;\r\n    //document.getElementById(\"C3\").value = county.options.length;\r\n    //document.getElementById(\"ComeWhere1\").value = province.options[province.selectedIndex].innerText + city.options[city.selectedIndex].innerText + county.options[county.selectedIndex].innerText;\r\n}\r\n\r\nfunction setArea(obj) {\r\n    var AreaCode = obj.value;\r\n    var str = obj.id;\r\n    var index = str.lastIndexOf('_');\r\n    var head = str.substring(0, index) + \"_\";\r\n    document.getElementById(head + \"AreaHid\").value = AreaCode;\r\n}\r\n\r\nfunction clearArea(obj)\r\n{\r\n    var provinceCode = obj.value;\r\n    var str = obj.id;\r\n    var index = str.lastIndexOf('_');\r\n    var head = str.substring(0, index) + \"_\";\r\n    var obj1 = document.getElementById(head + \"AreaDdl\");\r\n    obj1.innerHTML = \"\";\r\n    for(var i=0;i<obj1.childNodes.length;i++)\r\n    {\r\n        obj1.removeChild(obj1.options[i]);\r\n    }\r\n    document.getElementById(head + \"AreaHid\").value=\"\";\r\n}\r\n\r\nfunction clearCity(obj)\r\n{\r\n    var provinceCode = obj.value;\r\n    var str = obj.id;\r\n    var index = str.lastIndexOf('_');\r\n    var head = str.substring(0, index) + \"_\";\r\n    var obj1 = document.getElementById(head + \"CityDdl\");\r\n    obj1.innerHTML = \"\";\r\n    for (var i = 0; i < obj1.childNodes.length; i++) {\r\n        obj1.removeChild(obj1.options[i]);\r\n    }\r\n    document.getElementById(head + \"CityHid\").value = \"\";\r\n}"
