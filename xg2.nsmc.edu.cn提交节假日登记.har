          "cookies": [],
          "content": {
            "size": 7521,
            "mimeType": "application/javascript",
            "text": "///*加密方法代码*/\r\nvar GLobaencryption = {\r\n    encryption_Href: function () {\r\n        try {\r\n            if ($(\".white:not(.not_encryption)\")) {\r\n\r\n                $(\".white tr td:not(.not_encryption) a:not(.not_encryption)\").each(function (index) {\r\n                    /*根据页面打开情况不同，选择加密打开方式*/\r\n                    var url = $(this).attr(\"href\");\r\n                    var newurl = \"\";\r\n                    if (url != \"\" && url != \"#\" && url != \"javascript:void(0);\") {\r\n                        if (url.indexOf('?') > 0) {\r\n                            var url_head = url.substring(0, url.indexOf('?'));\r\n                            var arr = url.substring(url.indexOf('?') + 1).split('&');\r\n                            if (arr.length > 0) {\r\n                                newurl = url_head + '?';\r\n                                for (var i = 0; i < arr.length; i++) {\r\n                                    var arr1 = arr[i].split('=');\r\n                                    var name = arr1[0];\r\n                                    var value = arr1[1];\r\n                                    if (value != \"\") {\r\n                                        var reg = /=/g;\r\n                                        var newvalue = $.base64.btoa(value).replace(reg, ';');\r\n                                        if (i == 0)\r\n                                            newurl += name + \"=\" + newvalue;\r\n                                        else\r\n                                            newurl += \"&\" + name + \"=\" + newvalue;\r\n                                    }\r\n                                    else\r\n                                        if (i == 0)\r\n                                            newurl += name + \"=\" + value;\r\n                                        else\r\n                                            newurl += \"&\" + name + \"=\" + value;\r\n                                }\r\n\r\n                            }\r\n                            //alert(newurl);\r\n                            //newurl += \"&centersoft=abcedef\";\r\n                            var s1 = parseInt(10 * Math.random());\r\n                            //alert(s1);\r\n                            var salt1 = $.md5('' + s1);\r\n                            //alert(salt1);\r\n                            var salt2 = GLobaencryption.ConvertBlank(GLobaencryption.getrandom(1, 9999));\r\n                            //alert(salt2);\r\n                            newurl += salt1 + salt2;\r\n                            //alert(newurl);\r\n                            $(this).attr(\"href\", newurl);\r\n                        }\r\n                        else {\r\n                            newurl = url_head + '?';\r\n                            var arr1 = arr.split('=');\r\n                            var name = arr1[0];\r\n                            var value = arr1[1];\r\n                            if (value != \"\") {\r\n                                var reg = /=/g;\r\n                                var newvalue = $.base64.btoa(value).replace(reg, ';');\r\n                                newurl += name + \"=\" + newvalue;\r\n                            }\r\n                            else { newurl += name + \"=\" + value; }\r\n                            //newurl += \"&centersoft=abcedef\";\r\n                            var salt1 = $.md5(GLobaencryption.getrandom(10000, 10010));\r\n                            var salt2 = GLobaencryption.ConvertBlank(GLobaencryption.getrandom(1, 4000));\r\n                            newurl += salt1 + salt2;\r\n                            $(this).attr(\"href\", newurl);\r\n                        }\r\n                    }\r\n                })\r\n                //alert(idstr);\r\n            };\r\n        }\r\n        catch (error) {\r\n            console.log(error);\r\n        }\r\n    },\r\n    encryption_onclick: function () {\r\n        try {\r\n        if ($(\".white:not(.not_encryption)\")) {\r\n            $(\".white tr td:not(.not_encryption) a:not(.not_encryption)\").each(function (index) {\r\n                var url = $(this).context.attributes[1].value.split(\"'\")[1];\r\n                var newurl = \"\";\r\n                if (url != \"\" && url != \"#\" && url != \"javascript:void(0);\") {\r\n                    if (url.indexOf('?') > 0) {\r\n                        var url_head = url.substring(0, url.indexOf('?'));\r\n                        var arr = url.substring(url.indexOf('?') + 1).split('&');\r\n                        if (arr.length > 0) {\r\n                            newurl = url_head + '?';\r\n                            for (var i = 0; i < arr.length; i++) {\r\n                                var arr1 = arr[i].split('=');\r\n                                var name = arr1[0];\r\n                                var value = arr1[1];\r\n                                if (value != \"\") {\r\n                                    var reg = /=/g;\r\n                                    var newvalue = $.base64.btoa(value).replace(reg, ';');\r\n                                    if (i == 0)\r\n                                        newurl += name + \"=\" + newvalue;\r\n                                    else\r\n                                        newurl += \"&\" + name + \"=\" + newvalue;\r\n                                }\r\n                                else {\r\n                                    if (i == 0)\r\n                                        newurl += name + \"=\" + value;\r\n                                    else\r\n                                        newurl += \"&\" + name + \"=\" + value;\r\n                                }\r\n\r\n                            }\r\n                            var s1 = parseInt(10 * Math.random());\r\n                            var salt1 = $.md5('' + s1);\r\n                            var salt2 = GLobaencryption.ConvertBlank(GLobaencryption.getrandom(1, 9999));\r\n                            newurl += salt1 + salt2;\r\n                            $(this).attr(\"href\", newurl);\r\n                            $(this).removeAttr(\"onclick\");\r\n                        }\r\n                        else {\r\n                            newurl = url_head + '?';\r\n                            var arr1 = arr.split('=');\r\n                            var name = arr1[0];\r\n                            var value = arr1[1];\r\n                            if (value != \"\") {\r\n                                var reg = /=/g;\r\n                                var newvalue = $.base64.btoa(value).replace(reg, ';');\r\n                                newurl += name + \"=\" + newvalue;\r\n                            }\r\n                            else { newurl += name + \"=\" + value; }\r\n                            var salt1 = $.md5(GLobaencryption.getrandom(10000, 10010));\r\n                            var salt2 = GLobaencryption.ConvertBlank(GLobaencryption.getrandom(1, 4000));\r\n                            newurl += salt1 + salt2;\r\n                            $(this).attr(\"href\", newurl);\r\n                            $(this).removeAttr(\"onclick\");\r\n                        }\r\n                    }\r\n                }\r\n            });\r\n            }\r\n        }\r\n        catch (error) {\r\n            console.log(error);\r\n        }\r\n    },\r\n    getrandom: function (begin, end) {\r\n        return parseInt(Math.random() * (end - begin + 1) + begin);\r\n    },\r\n    ConvertBlank: function (i) {\r\n        if (i < 10)\r\n            return '000' + i;\r\n        else if (i < 100)\r\n            return '00' + i;\r\n        else if (i < 1000)\r\n            return '0' + i;\r\n        else\r\n            return i;\r\n    }\r\n}\r\n\r\n"
          },
