          "content": {
            "size": 17909,
            "mimeType": "application/javascript",
            "text": "\r\n$(function () {\r\n    Index.init();\r\n});\r\n\r\n\r\nif (typeof (window.parent.layer_index) != \"undefined\") {\r\n    var layer_index = parent.layer.getFrameIndex(window.name); //获取窗口索引;\r\n}\r\n\r\nvar Index = {\r\n    init: function () {\r\n        /*页面必加载部分*/\r\n        this.documentBody();//计算页面高度，调整滚动条\r\n        this.SearchTitle();//search部分收起打开\r\n        this.urlparamreplace();//表格链接加密(需根据表单链接设置情况修改)\r\n        this.tablerows();//表单行内设定加载 \r\n        this.OpenA();//将页面a标签打开方式修改，改为layer弹窗模式\r\n        this.CloseA();//关闭弹窗方法     \r\n        this.selectStyle();//模糊查询项\r\n    },\r\n    documentBody: function () {//计算页面高度，调整滚动条\r\n        var wind_h = $(window).height();\r\n        var form_h = $(\"form[name='form1']\").height();\r\n\r\n        if (form_h > wind_h) {\r\n            $(\"body\").css({ \"height\": \"css\" })\r\n            $(\"body\").css({ \"overflow-y\": \"auto\" });\r\n        } else {\r\n            $(\"body\").css({ \"overflow-y\": \"auto\" });\r\n        }\r\n    },\r\n    SearchTitle: function () {//search部分收起打开\r\n        $(\".SearchTitle\").unbind().click(function () {\r\n            $(\"#odiv\").toggle();\r\n            $(\".fa-angle-double-up\").toggleClass(\"rotate\");\r\n        });\r\n    },\r\n    tablerows: function () {//表单行内设定加载，包含基偶行设置，全选设置\r\n        //grid奇偶行\r\n        $(\".white tr:even\").addClass(\"trEven\");\r\n        $(\".white tr:odd\").addClass(\"trOdd\");\r\n\r\n        $(\"#checkall\").click(function () {\r\n            var ischecked = this.checked;\r\n            $(\"input:checkbox[name='ids']\").each(function () {\r\n                this.checked = ischecked;\r\n            });\r\n            $.uniform.update(':checkbox');\r\n        });\r\n    },\r\n    urlparamreplace: function () { //表格链接加密\r\n        /*\r\n         * 根据表单链接打开情况修改  \r\n         * 下载部分，上传部分，不做加密\r\n         * 不需要加密的表单，请在table头部添加class：not_encryption;\r\n         * encryption_Href() 打开方式为转换地址url为href\r\n         * encryption_onclick 打开方式为转换地址SHDonClick为href\r\n         * 调用时放在OpenA方法之后，根据页面打开方式不同，合理调用其中一种\r\n         */\r\n        GLobaencryption.encryption_Href()\r\n\r\n        /*方法代码*/\r\n\r\n    },\r\n    OpenA: function () {//将页面a标签打开方式修改，改为layer弹窗模式\r\n\r\n        try {\r\n            //新增按钮\r\n            $(\".fa-plus:not(.not_layer_open)\").each(function () {\r\n                var add_a = $(this).parent();\r\n                var href = add_a.attr(\"href\");\r\n\r\n                if (href.indexOf(\".\") > 0 && href.indexOf(\"javascript\") < 0) {\r\n                    add_a.attr(\"url\", href);\r\n                    add_a.attr(\"href\", \"javascript:void(0);\");\r\n\r\n                    add_a.click(function () {\r\n                        layer_index = layer.open({\r\n                            border: 0,\r\n                            title: false,\r\n                            type: 2,\r\n                            area: ['100%', '100%'],\r\n                            offset: '0px',\r\n                            shade: 0.8,\r\n                            closeBtn: 0,\r\n                            shadeClose: true,\r\n                            content: $(this).attr(\"url\"),\r\n                            scrollbar: false\r\n                        });\r\n                    });\r\n                }\r\n            });\r\n            //列表页面\r\n            $(\".white a:not(.not_layer_open)\").each(function () {\r\n                var a_obj = $(this);\r\n                var href = a_obj.attr(\"href\");\r\n\r\n                if (href.indexOf(\".\") > 0 && href.indexOf(\"javascript\") < 0) {\r\n                    a_obj.attr(\"url\", href);\r\n                    a_obj.attr(\"href\", \"javascript:void(0);\");\r\n\r\n                    a_obj.click(function () {\r\n                        layer_index = layer.open({\r\n                            border: 0,\r\n                            title: false,\r\n                            type: 2,\r\n                            area: ['100%', '100%'],\r\n                            offset: '0px',\r\n                            shade: 0.8,\r\n                            closeBtn: 0,\r\n                            shadeClose: true,\r\n                            content: $(this).attr(\"url\"),\r\n                            scrollbar: false\r\n                        });\r\n                    });\r\n                }\r\n            });\r\n            //父页面列表的超链接（自动应用弹出层方式）\r\n            $(\".white td:not(.not_layer_open) a:not(.not_layer_open)\").each(function () {\r\n                try {\r\n                    var a_obj = $(this);\r\n                    var href = a_obj.attr(\"href\");\r\n                    if (typeof (href) != \"undefined\") {\r\n\r\n                        if (href.indexOf(\".aspx\") > 0) {\r\n\r\n                            a_obj.attr(\"url\", href);\r\n                            a_obj.attr(\"href\", \"javascript:void(0);\");\r\n                            a_obj.click(function () {\r\n                                layer_fun_Open($(this).attr(\"url\"));\r\n                            });\r\n                        }\r\n                    }\r\n                } catch (e) { console.log(e.message); }\r\n            });\r\n            //明细页面\r\n            if (typeof (window.parent.layer_index) != \"undefined\") {\r\n                $(\".fa-mail-reply\").each(function () {\r\n                    var back_a = $(this).parent();\r\n                    var href = back_a.attr(\"href\");\r\n\r\n                    back_a.attr(\"url\", href);\r\n                    back_a.attr(\"href\", \"javascript:void(0);\");\r\n                    back_a.click(function () {\r\n                        window.parent.indexClose();\r\n                    });\r\n                });\r\n                $(\".fa-reply:not(.not_layer_close)\").each(function () {\r\n                    var back_a = $(this).parent();\r\n                    var href = back_a.attr(\"href\");\r\n                    back_a.attr(\"url\", href);\r\n                    back_a.attr(\"href\", \"javascript:void(0);\");\r\n                    back_a.click(function () {\r\n                        var index = parent.layer.getFrameIndex(window.name); //获取窗口索引\r\n                        parent.layer.close(index);\r\n                    });\r\n                });\r\n            }\r\n        }\r\n        catch (error) {\r\n            console.log(error);\r\n        }\r\n    },\r\n    CloseA: function () { //子页面顶部的返回按钮（自动应用关闭弹出层）\r\n        if (typeof (window.parent.layer_index) != \"undefined\") {\r\n            $(\".fa-reply:not(.not_layer_close)\").each(function () {\r\n                var back_a = $(this).parent();\r\n                var href = back_a.attr(\"href\");\r\n                back_a.attr(\"url\", href);\r\n                back_a.attr(\"href\", \"javascript:void(0);\");\r\n                back_a.click(function () {\r\n                    window.parent.layer_fun_Parent_Close();\r\n                });\r\n            });\r\n        }\r\n    },\r\n    selectStyle: function () {//select优化，模糊查询项\r\n        /*min为设置超过多少个option允许模糊查询\r\n         * 建议设置为15\r\n         */\r\n        $('select').serect({ min: 10 });//模糊查询\r\n    }\r\n}\r\n\r\n/*\r\n * 页面内调用事件部分\r\n */\r\n\r\n//框架收缩\r\nvar DisplayStatus = \"0\";\r\nfunction DisplayAndHide() {\r\n    if (DisplayStatus == \"0\") {\r\n        DisplayStatus = \"1\";\r\n    } else {\r\n        DisplayStatus = \"0\";\r\n    }\r\n}\r\n//切换热点区域，用于用户权限头部切换\r\nvar navigationBarStatus = \"0\";\r\nfunction displayNavigationBar() {\r\n    if (navigationBarStatus == \"0\") {\r\n        top.frmWorkSpace.cols = \"1,14,*\";\r\n        NavigationMenu.imgChange.src = 'FrameImages/kuozhan.jpg'\r\n        navigationBarStatus = \"1\";\r\n    } else {\r\n        top.frmWorkSpace.cols = \"226,14,*\";\r\n        NavigationMenu.imgChange.src = 'FrameImages/sousuo.jpg'\r\n        navigationBarStatus = \"0\";\r\n    }\r\n}\r\n\r\n//限制用户输入并提示\r\nfunction isOver(ContorlName, sText, len) {\r\n    var intlen = sText.value.length;\r\n    if (intlen > len) {\r\n        sText.select();\r\n        alert('“' + ContorlName + '”输入内容太多，超过限制。请调整为长度' + len + ',否则系统出错！');\r\n        //            sText.focus();\r\n    }\r\n}\r\n\r\n//产生全屏的滚动\r\nfunction CheckFileTypeJPG(objFileUpload) {\r\n    var FileName = new String(objFileUpload.value); //文件名\r\n    var extension = new String(FileName.substring(FileName.lastIndexOf(\".\") + 1, FileName.length)); //文件扩展名\r\n\r\n    if (extension.toUpperCase() != \"JPG\" && extension.toUpperCase() != \"JPEG\" && extension.toUpperCase() != \"PNG\") //你可以添加扩展名\r\n    {\r\n        layer.alert(\"本附件只支持jpg、jpeg、png格式！\");\r\n        objFileUpload.outerHTML = objFileUpload.outerHTML;\r\n    }\r\n}\r\n\r\n//SHDonclick方法打开事件   ex:url：aaa.aspx?id=1\r\nfunction SHDialog(url) {\r\n    layer.open({\r\n        border: 0,\r\n        title: false,\r\n        type: 2,\r\n        area: ['100%', '100%'],\r\n        offset: '0px',\r\n        shade: 0.8,\r\n        closeBtn: 0,\r\n        shadeClose: true,\r\n        content: url,\r\n        scrollbar: false\r\n    });\r\n}\r\n\r\n//----弹出层的返回按钮事件[只是单纯的点击返回操作]----------------\r\nfunction GoBack() {\r\n    var index = parent.layer.getFrameIndex(window.name); //获取窗口索引\r\n    //parent.$('#BtnSearch').click(); //---BtnSearch  父页面查询按钮的Id\r\n    var jump_btn = parent.$(\"input[value='跳  转']\");\r\n    if (jump_btn.length == 1) {\r\n        var page_container = jump_btn.parent();\r\n        var page = parent.$(\".PageNumber\").text();\r\n        page_container.find(\"input[type='text']\").eq(0).val(page);\r\n        jump_btn.removeAttr(\"disabled\");\r\n        jump_btn.click();\r\n    } else {\r\n        var re_btn = parent.$(\".re_btn\");\r\n        if (re_btn.length > 0) {\r\n            re_btn.click();\r\n        } else {\r\n            re_btn = parent.$(\"#BtnSearch\");\r\n            if (re_btn.length > 0) {\r\n                re_btn.click();\r\n            } else {\r\n                re_btn = parent.$(\"input[value='查询']\");\r\n                if (re_btn.length > 0) {\r\n                    re_btn.click();\r\n                } else {\r\n                    re_btn = parent.$(\"input[value='查 询']\");\r\n                    if (re_btn.length > 0) {\r\n                        re_btn.click();\r\n                    } else {\r\n                        re_btn = parent.$(\"input[value='查  询']\");\r\n                        if (re_btn.length > 0) {\r\n                            re_btn.click();\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    }\r\n    parent.layer.close(index);\r\n\r\n}\r\n//----弹出层的操作后返回按钮事件----------------\r\nfunction OperateGoBack() {\r\n    var index = parent.layer.getFrameIndex(window.name); //获取窗口索引\r\n    layer.msg(\"操作成功!\");\r\n    parent.$('#BtnSearch').click(); //---BtnSearch  父页面查询按钮的Id\r\n    parent.layer.close(index);\r\n}\r\n\r\n//---弹出层处理[弹出小窗体]---\r\n//ex:url：aaa.aspx?id=1\r\nfunction AddEditDialog(url, width, height) {\r\n    layer.open({\r\n        border: 0,\r\n        title: false,\r\n        type: 2,\r\n        area: [width, height],\r\n        shade: 0.8,\r\n        closeBtn: 0,\r\n        shadeClose: false,\r\n        content: url\r\n    });\r\n}\r\n//GridView layer 删除确认 TipMsg为删除按钮上的属性，即提示内容\r\nfunction LayerConfirm(obj) {\r\n    var tipMsg = obj.parentNode.lastElementChild.getAttribute(\"TipMsg\");\r\n    if (tipMsg == null || tipMsg == \"\") {\r\n        tipMsg = \"您确定要删除该条记录吗?\";\r\n    }\r\n    layer.confirm(tipMsg, {\r\n        btn: ['确定', '取消']\r\n    },\r\n        function () {\r\n            layer.closeAll();\r\n            obj.parentNode.lastElementChild.click();\r\n            return true;\r\n        },\r\n        function () {\r\n            layer.closeAll();\r\n            return false;\r\n        });\r\n}\r\n\r\n\r\n//直接调用关闭方法（需要往页面注册脚本的方式调用）\r\nfunction fun_indexClose() {\r\n    if (typeof (window.parent.layer_index) != \"undefined\") {\r\n        window.parent.indexClose();\r\n    }\r\n}\r\n\r\n//关闭弹出层\r\nfunction indexClose() {\r\n    layer.close(layer_index);\r\n    var jump_btn = $(\"input[value='跳  转']\");\r\n    if (jump_btn.length == 1) {\r\n        var page_container = jump_btn.parent();\r\n        var page = $(\".PageNumber\").text();\r\n        page_container.find(\"input[type='text']\").eq(0).val(page);\r\n        jump_btn.removeAttr(\"disabled\");\r\n        jump_btn.click();\r\n    } else {\r\n        var re_btn = $(\".re_btn\");\r\n        if (re_btn.length > 0) {\r\n            re_btn.click();\r\n        } else {\r\n            re_btn = $(\"#BtnSearch\");\r\n            if (re_btn.length > 0) {\r\n                re_btn.click();\r\n            } else {\r\n                re_btn = $(\"input[value='查询']\");\r\n                if (re_btn.length > 0) {\r\n                    re_btn.click();\r\n                } else {\r\n                    re_btn = $(\"input[value='查 询']\");\r\n                    if (re_btn.length > 0) {\r\n                        re_btn.click();\r\n                    } else {\r\n                        re_btn = $(\"input[value='查  询']\");\r\n                        if (re_btn.length > 0) {\r\n                            re_btn.click();\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n}\r\n\r\n\r\n//弹出方法（后台触发需要使用脚本注册的方式）\r\nfunction layer_fun_Open(url) {\r\n    try {\r\n        layer_index = layer.open({\r\n            border: 0,\r\n            title: false,\r\n            type: 2,\r\n            area: ['100%', '100%'],\r\n            offset: '0px',\r\n            shade: 0.8,\r\n            closeBtn: 0,\r\n            shadeClose: true,\r\n            content: url,\r\n            scrollbar: false\r\n        });\r\n    } catch (e) { console.log(e.message); }\r\n}\r\n\r\n//子窗口调用关闭方法（后台触发需要使用脚本注册的方式）\r\nfunction layer_fun_Child_Close(url) {\r\n    try {\r\n        if (typeof (window.parent.layer_index) != \"undefined\") {\r\n            window.parent.layer_fun_Parent_Close();\r\n        } else {\r\n            window.location.href = url;\r\n        }\r\n    } catch (e) { console.log(e.message); }\r\n}\r\n//父窗口调用关闭方法（后台触发需要使用脚本注册的方式）\r\nfunction layer_fun_Parent_Close() {\r\n    try {\r\n        layer.close(layer_index);\r\n\r\n        var jump_btn = $(\"input[value='跳  转']\");\r\n        if (jump_btn.length == 1) {\r\n            var page_container = jump_btn.parent();\r\n            var page = page_container.find(\"span\").eq(0).find(\"font\").eq(2).text();\r\n            page_container.find(\"input[type='text']\").eq(0).val(page);\r\n            jump_btn.removeAttr(\"disabled\");\r\n            jump_btn.click();\r\n        } else {\r\n            var re_btn = $(\".re_btn\");\r\n            if (re_btn.length > 0) {\r\n                re_btn.click();\r\n            } else {\r\n                re_btn = $(\"#BtnSearch\");\r\n                if (re_btn.length > 0) {\r\n                    re_btn.click();\r\n                } else {\r\n                    re_btn = $(\"input[value='查询']\");\r\n                    if (re_btn.length > 0) {\r\n                        re_btn.click();\r\n                    } else {\r\n                        re_btn = $(\"input[value='查 询']\");\r\n                        if (re_btn.length > 0) {\r\n                            re_btn.click();\r\n                        } else {\r\n                            re_btn = $(\"input[value='查  询']\");\r\n                            if (re_btn.length > 0) {\r\n                                re_btn.click();\r\n                            }\r\n                        }\r\n                    }\r\n                }\r\n            }\r\n        }\r\n\r\n    } catch (e) { console.log(e.message); }\r\n}\r\n\r\n//------gridview 行删除---确认\r\nfunction DelSure(obj) {\r\n    layer.confirm(\"您确定要删除此行数据吗？\", {\r\n        btn: ['确认', '取消']\r\n    }, function () {\r\n        layer.closeAll();\r\n        obj.parentNode.lastElementChild.click();\r\n        return true;\r\n    },\r\n        function () {\r\n            layer.closeAll();\r\n            return false;\r\n        });\r\n}\r\n\r\nfunction OperateSure(Mes, ElementId) {\r\n    layer.confirm(Mes, {\r\n        btn: ['确认', '取消']\r\n    }, function () {\r\n        layer.closeAll();\r\n        if (ElementId != \"\")\r\n            document.getElementById(ElementId).click();\r\n        return true;\r\n    },\r\n        function () {\r\n            layer.closeAll();\r\n            return false;\r\n        });\r\n}\r\n\r\n\r\n/*单个按钮Layer询问框Begin */\r\nfunction LayerClick(obj, msg) {\r\n    $(obj).attr(\"LayerClick\", \"0\");\r\n    layer.confirm(msg, {\r\n        btn: ['确定', '取消']\r\n    },\r\n        function () {\r\n            layer.closeAll();\r\n            $(obj).attr(\"LayerClick\", \"1\");\r\n            document.getElementById($(obj).attr(\"id\")).click();\r\n        },\r\n        function () {\r\n            layer.closeAll();\r\n            $(obj).attr(\"LayerClick\", \"0\");\r\n        });\r\n}\r\nfunction MLayer(obj, msg) {\r\n    var browser = navigator.appName;\r\n    var version = navigator.appVersion.split(\";\")[1].replace(/[ ]/g, \"\");\r\n    if (browser == \"Microsoft Internet Explorer\" && (version == \"MSIE6.0\" || version == \"MSIE7.0\" || version == \"MSIE8.0\" || version == \"MSIE9.0\")) {\r\n        return confirm(msg);\r\n    } else {\r\n        if (typeof ($(obj).attr(\"LayerClick\")) != \"undefined\" && $(obj).attr(\"LayerClick\") == \"1\") {\r\n            $(obj).attr(\"LayerClick\", \"0\");\r\n            return true;\r\n        } else {\r\n            this.LayerClick(obj, msg);\r\n            return false;\r\n        }\r\n    }\r\n}\r\n/*单个按钮Layer询问框  End */"
          },
