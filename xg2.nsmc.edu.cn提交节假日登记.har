sp;&nbsp;4.我保证按时返校。<br>\r\n            &nbsp;&nbsp;5.请假通过后打印出请假条、签字、盖章<br>\r\n            <br />\r\n            &nbsp;&nbsp;学生签字：\r\n          <span id=\"Leave1_UserName\" style=\"font-weight: 700; color: #FF0000\">敬宇翔</span>\r\n            <br>\r\n            <br />\r\n        </td>\r\n    </tr>\r\n</table>\r\n<input name=\"Leave1$LeaveBeginDate2\" type=\"hidden\" id=\"Leave1_LeaveBeginDate2\" style=\"width: 9px\" value=\"2026-06-25\" />\r\n<input name=\"Leave1$LeaveEndDate2\" type=\"hidden\" id=\"Leave1_LeaveEndDate2\" style=\"width: 11px\" value=\"2026-08-30\" />\r\n\r\n<script>\r\n    laydate.render({\r\n        elem: document.getElementById('Leave1_LeaveBeginDate') //指定元素\r\n    });\r\n    laydate.render({\r\n        elem: document.getElementById('Leave1_LeaveEndDate') //指定元素\r\n    });\r\n    laydate.render({\r\n        elem: document.getElementById('Leave1_GoDate') //指定元素\r\n    });\r\n    laydate.render({\r\n        elem: document.getElementById('Leave1_BackDate') //指定元素\r\n    });\r\n\r\n    function getNowFormatDate() {\r\n        var day = new Date();\r\n\r\n        var Year = 0;\r\n        var Month = 0;\r\n        var Day = 0;\r\n        var CurrentDate = \"\";\r\n        //初始化时间   \r\n        Year = day.getFullYear();\r\n        Month = day.getMonth() + 1;\r\n        Day = day.getDate();\r\n\r\n        CurrentDate += Year + \"-\";\r\n\r\n        if (Month >= 10) {\r\n            CurrentDate += Month + \"-\";\r\n        }\r\n        else {\r\n            CurrentDate += \"0\" + Month + \"-\";\r\n        }\r\n        if (Day >= 10) {\r\n            CurrentDate += Day;\r\n        }\r\n        else {\r\n            CurrentDate += \"0\" + Day;\r\n        }\r\n        return CurrentDate;\r\n    }\r\n\r\n\r\n    function getDateDiff() {\r\n        if (document.getElementById(\"Leave1_LeaveBeginDate\").value != \"\" && document.getElementById(\"Leave1_LeaveEndDate\").value != \"\") {\r\n            if (document.getElementById(\"Leave1_LeaveBeginDate\").value < document.getElementById(\"Leave1_LeaveBeginDate2\").value) {\r\n                layer.alert('去向时间不在节假日放假时间段内！');\r\n                document.getElementById(\"Leave1_LeaveBeginDate\").value = \"\";\r\n            }\r\n            else if (document.getElementById(\"Leave1_LeaveEndDate\").value > document.getElementById(\"Leave1_LeaveEndDate2\").value) {\r\n                layer.alert('去向时间不在节假日放假时间段内！');\r\n                document.getElementById(\"Leave1_LeaveEndDate\").value = \"\";\r\n            }\r\n            else {\r\n                if (document.getElementById(\"Leave1_LeaveBeginDate\").value > document.getElementById(\"Leave1_LeaveEndDate\").value) {\r\n                    layer.alert('去向结束时间必须大于等于开始时间！');\r\n                    document.getElementById(\"Leave1_LeaveEndDate\").value = \"\";\r\n                }\r\n                else if (document.getElementById(\"Leave1_LeaveBeginDate\").value == document.getElementById(\"Leave1_LeaveEndDate\").value) {\r\n                    document.getElementById(\"Leave1_LeaveDay\").value = \"0\";\r\n                    if (document.getElementById(\"Leave1_LeaveBeginTime\").value <= document.getElementById(\"Leave1_LeaveEndTime\").value) {\r\n                        DateDiff1(document.getElementById(\"Leave1_LeaveBeginTime\").value, document.getElementById(\"Leave1_LeaveEndTime\").value);\r\n                    }\r\n                    else {\r\n                        layer.alert('去向结束时间必须大于等于开始时间！');\r\n                        document.getElementById(\"Leave1_LeaveBeginTime\").value = \"08\";\r\n                        document.getElementById(\"Leave1_LeaveEndTime\").value = \"08\";\r\n                    }\r\n                }\r\n                else\r\n                    DateDiff2(document.getElementById(\"Leave1_LeaveBeginDate\").value, document.getElementById(\"Leave1_LeaveEndDate\").value, document.getElementById(\"Leave1_LeaveBeginTime\").value, document.getElementById(\"Leave1_LeaveEndTime\").value);\r\n\r\n\r\n                if (document.getElementById(\"Leave1_GoDate\").value != \"\") {\r\n                    if (new Date(document.getElementById(\"Leave1_LeaveBeginDate\").value.replace(\"-\", \",\")).getTime() > new Date(document.getElementById(\"Leave1_GoDate\").value.replace(\"-\", \",\")).getTime()\r\n    || (new Date(document.getElementById(\"Leave1_LeaveBeginDate\").value.replace(\"-\", \",\")).getTime() == new Date(document.getElementById(\"Leave1_GoDate\").value.replace(\"-\", \",\")).getTime()\r\n                        && document.getElementById(\"Leave1_GoTime\").value < document.getElementById(\"Leave1_LeaveBeginTime\").value)\r\n                    || new Date(document.getElementById(\"Leave1_GoDate\").value.replace(\"-\", \",\")).getTime() > new Date(document.getElementById(\"Leave1_LeaveEndDate\").value.replace(\"-\", \",\")).getTime()\r\n                    || (new Date(document.getElementById(\"Leave1_LeaveEndDate\").value.replace(\"-\", \",\")).getTime() == new Date(document.getElementById(\"Leave1_GoDate\").value.replace(\"-\", \",\")).getTime()\r\n                        && document.getElementById(\"Leave1_GoTime\").value > document.getElementById(\"Leave1_LeaveEndTime\").value)) {\r\n                        layer.alert('出发时间必须在去向时间内！');\r\n                        document.getElementById(\"Leave1_GoDate\").value = \"\";\r\n                    }\r\n                }\r\n\r\n                if (document.getElementById(\"Leave1_BackDate\").value != \"\") {\r\n                    if (document.getElementById(\"Leave1_GoDate\").value > document.getElementById(\"Leave1_BackDate\").value) {\r\n                        layer.alert('返回时间必须大于等于出发时间！');\r\n                        document.getElementById(\"Leave1_BackDate\").value = \"\";\r\n                    }\r\n                    if (new Date(document.getElementById(\"Leave1_LeaveBeginDate\").value.replace(\"-\", \",\")).getTime() > new Date(document.getElementById(\"Leave1_BackDate\").value.replace(\"-\", \