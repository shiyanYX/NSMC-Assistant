day = parseInt(days / (1000 * 60 * 60 * 24));\r\n\r\n            document.getElementById(\"Leave1_LeaveDay\").value = day.toString();\r\n\r\n            iDays = (parseFloat((endTime - beginTime))).toString();\r\n            document.getElementById(\"Leave1_LeaveHour\").value = iDays.toString();\r\n        }\r\n\r\n</script>\r\n\r\n\r\n        </div>\r\n    \r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nvar Page_Validators =  new Array(document.getElementById(\"Leave1_RequiredFieldValidator1\"), document.getElementById(\"Leave1_RequiredFieldValidator10\"), document.getElementById(\"Leave1_RequiredFieldValidator9\"), document.getElementById(\"Leave1_RequiredFieldValidator2\"), document.getElementById(\"Leave1_RequiredFieldValidator3\"), document.getElementById(\"Leave1_RequiredFieldValidator4\"), document.getElementById(\"Leave1_re\"), document.getElementById(\"Leave1_RegularExpressionValidator4\"), document.getElementById(\"Leave1_RequiredFieldValidator5\"), document.getElementById(\"Leave1_RegularExpressionValidator2\"), document.getElementById(\"Leave1_RequiredFieldValidator6\"), document.getElementById(\"Leave1_RequiredFieldValidator7\"), document.getElementById(\"Leave1_RequiredFieldValidator8\"), document.getElementById(\"Leave1_RegularExpressionValidator3\"));\r\n//]]>\r\n</script>\r\n\r\n<script type=\"text/javascript\">\r\n//<![CDATA[\r\nvar Leave1_RequiredFieldValidator1 = document.all ? document.all[\"Leave1_RequiredFieldValidator1\"] : document.getElementById(\"Leave1_RequiredFieldValidator1\");\r\nLeave1_RequiredFieldValidator1.controltovalidate = \"Leave1_LeaveBeginDate\";\r\nLeave1_RequiredFieldValidator1.focusOnError = \"t\";\r\nLeave1_RequiredFieldValidator1.errormessage = \"必填\";\r\nLeave1_RequiredFieldValidator1.display = \"Dynamic\";\r\nLeave1_RequiredFieldValidator1.evaluationfunction = \"RequiredFieldValidatorEvaluateIsValid\";\r\nLeave1_RequiredFieldValidator1.initialvalue = \"\";\r\nvar Leave1_RequiredFieldValidator10 = document.all ? 