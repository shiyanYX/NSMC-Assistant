          "content": {
            "size": 9490,
            "mimeType": "application/javascript",
            "text": "/*\r\n  时间：\t\t2018-11-16\r\n  作者：\t\tluowei\r\n  功能：\t\t下拉框搜索\r\n  依赖：\t\tjquery\r\n  调用方法：\t$(\"select\").serect({\r\n                                        min: 20     //最小生效选项数（默认20）\r\n                                        width: 200  //文本框宽带（默认下拉框宽度）\r\n                                        height: 18  //文本框高度（默认下拉框高度）\r\n                                        itop: 8     //文本框倒三角距文本框顶部距离（默认8px）\r\n                                    });\r\n*/\r\n; (function (jq) {\r\n    var gv_serect_input;\r\n    var gv_serect_container;\r\n\r\n    jq.fn.serect = function (par) {\r\n        this.each(function () {\r\n            var select = $(this);\r\n            if (select.attr(\"multiple\") == \"multiple\") return;\r\n            if (select.attr(\"disabled\") == \"disabled\") return;\r\n            if (select.hasClass(\"NoSelect\") == true) return;\r\n            var param = $.extend(true, { min: 20, width: select.outerWidth() + 20, height: select.outerHeight(false), itop: 8 }, par);//最长的那一行会换行(width + 3)扣除text-index部分\r\n\r\n            if (select.find(\"option\").length < param.min) {\r\n                return;\r\n            }\r\n            var input = $(\"<input type='text' style='text-indent:3px;margin:0 !important' />\");\r\n            input.css(\"width\", param.width + \"px\");\r\n            input.css(\"height\", param.height + \"px\");\r\n            input.val(select.find(\"option:selected\").text());//初始化赋值\r\n\r\n            input.click(function () {\r\n                input_click($(this));\r\n            });\r\n            input.keyup(function () {\r\n                input_keyup($(this));\r\n            });\r\n\r\n            var span = $(\"<span style='position:relative;padding:0px;margin:0px;width:auto;height:auto;z-index:9999;'><i style='position:relative;width:0px;height:0px;border:4px solid transparent;border-top:4px solid #000000;top:\" + param.itop + \"px;right:15px;z-index:9999;'></i></span>\");\r\n\r\n            select.hide();\r\n            select.after(span.prepend(input));\r\n        });\r\n\r\n        var input_click = function (input) {\r\n            gv_serect_input = $(input);\r\n            $(gv_serect_container).remove();\r\n\r\n            var s_top = gv_serect_input.offset().top;\r\n            var s_left = gv_serect_input.offset().left;\r\n\r\n            var s_width = gv_serect_input.outerWidth();\r\n            var s_height = gv_serect_input.height();\r\n\r\n\r\n            var container = $(\"<div style='position:absolute;z-index:9999;overflow-x:hidden;overflow-y:scroll;background-color:white;border:1px solid #7A9CD3;height:auto;max-height:170px;'><div style='text-indent:3px;cursor:default;height:18px;line-height:18px;display:none;' class='no_key'></div></div>\");\r\n            container.css(\"top\", (s_top + s_height) + \"px\");\r\n            container.css(\"left\", s_left + \"px\");\r\n            container.css(\"width\", (s_width - 2) + \"px\");//除去边框的2像素\r\n\r\n\r\n            var scroll_top = 0;\r\n            var select = gv_serect_input.parent().prev();\r\n            select.find(\"option\").each(function (n) {\r\n                var text = $(this).text();\r\n                var value = $(this).val();\r\n\r\n                var option = $(\"<div style='text-indent:3px;cursor:default;height:18px;line-height:18px;'></div>\");\r\n\r\n                option.text(text);\r\n                option.attr(\"value\", value);\r\n\r\n                if (gv_serect_input.val() == text) {\r\n                    scroll_top = n * 18;\r\n                    option.css(\"background-color\", \"#1E90FF\").css(\"color\", \"#FFFFFF\");\r\n                }\r\n\r\n                option.hover(function () {\r\n                    $(this).parent().find(\"div\").each(function () {\r\n                        $(this).css(\"background-color\", \"#FFFFFF\").css(\"color\", \"#000000\");\r\n                    })\r\n                    $(this).css(\"background-color\", \"#1E90FF\").css(\"color\", \"#FFFFFF\");\r\n                }, function () {\r\n                    $(this).css(\"background-color\", \"#FFFFFF\").css(\"color\", \"#000000\");\r\n                });\r\n\r\n                option.click(function () {\r\n                    var o_value = select.val();\r\n                    var text = $(this).text();\r\n                    var value = $(this).attr(\"value\");\r\n                    select.val(value);\r\n\r\n                    var istrigger = o_value != select.val();//判断是否改变选项，如改变则执行select原有的事件\r\n\r\n                    gv_serect_input.val(text);\r\n                    gv_serect_container.remove();\r\n\r\n                    if (istrigger) {\r\n                        select.trigger(\"change\");//执行事件\r\n                    }\r\n                });\r\n\r\n                container.append(option);\r\n            });\r\n\r\n            $(\"body\").append(container);\r\n            gv_serect_container = container;\r\n            container.scrollTop(scroll_top - (3 * 18));\r\n\r\n            correctionPosition();\r\n        };\r\n\r\n        var input_keyup = function (input) {\r\n            gv_serect_input = $(input);\r\n            var flag = false;\r\n            var key = gv_serect_input.val();\r\n            gv_serect_container.find(\"div\").each(function () {\r\n                var index = $(this).text().toLowerCase().indexOf(key.toLowerCase());\r\n                if (index > -1) {\r\n                    flag = true;\r\n                    var leftChar = $(this).text().substring(0, index);\r\n                    var keyChar = $(this).text().substring(index, index + key.length);\r\n                    var rightChar = $(this).text().substring(index + key.length);\r\n                    $(this).html(leftChar + \"<span style='color:red;'><u>\" + keyChar + \"</u></span>\" + rightChar);//关键字加红\r\n                    $(this).show();\r\n                } else {\r\n                    $(this).hide();\r\n                }\r\n            });\r\n            if (flag) {\r\n                gv_serect_container.find(\".no_key\").html(\"\").hide();\r\n            } else {\r\n                gv_serect_container.find(\".no_key\").html(\"<span style='color:red;'>无匹配</span>\").show();\r\n            }\r\n\r\n            correctionPosition();\r\n        };\r\n\r\n        //以下代码用于校正容器和文本框的位置。\r\n        //显示或隐藏容器可能会导致整个页面高度的变化（滚动条的出现或隐藏），使容器和文本框的位置出现偏移。\r\n        var correctionPosition = function () {\r\n            var s_top = gv_serect_input.offset().top;\r\n            var s_left = gv_serect_input.offset().left;\r\n            var s_width = gv_serect_input.outerWidth(true);\r\n            var s_height = gv_serect_input.outerHeight(true);//gv_serect_input的高度\r\n            var gv_serect_container_height = gv_serect_container.outerHeight(true);//gv_serect_container的高度\r\n            var window_height = window.innerHeight;//工作区内部高度\r\n            if (s_top + s_height + gv_serect_container_height > window_height) {//如果gv_serect_container向下弹出超出工作区，则改为向上弹出\r\n                var s_scolltop = s_top - $(document).scrollTop();//gv_serect_input到工作区顶部的距离 即上工作区\r\n                var gv_serect_container_newheight = gv_serect_container_height;//重设gv_serect_container的高度\r\n                if (s_scolltop < gv_serect_container_height) {//如果gv_serect_container向上弹出超出工作区\r\n                    gv_serect_container_newheight = parseInt(s_scolltop / 18) * 18;//重设gv_serect_container的高度为上工作区高度\r\n                    gv_serect_container.css(\"height\", gv_serect_container_newheight + \"px\");\r\n                }\r\n                if (window_height - s_height - s_scolltop > s_scolltop) {//如果上工作区高度小于下工作区，gv_serect_container向下弹出并重设高度\r\n                    gv_serect_container_newheight = parseInt((window_height - s_height - s_scolltop) / 18) * 18;\r\n                    gv_serect_container.css(\"height\", gv_serect_container_newheight + \"px\");\r\n                    gv_serect_container.css(\"top\", (s_top + s_height) + \"px\");\r\n                }\r\n                else\r\n                    gv_serect_container.css(\"top\", (s_top - gv_serect_container_newheight) + \"px\");\r\n            }\r\n            else {\r\n                gv_serect_container.css(\"top\", (s_top + s_height) + \"px\");\r\n            }\r\n            gv_serect_container.css(\"left\", s_left + \"px\");\r\n        };\r\n\r\n        $(window).click(function (e) {\r\n            var target = $(e.target);\r\n            var input = $(gv_serect_input);\r\n            var container = $(gv_serect_container);\r\n\r\n            if (target.is(input)) {\r\n                return;\r\n            }\r\n            if (target.is(container)) {\r\n                return;\r\n            }\r\n            if (target.parent().is(container)) {\r\n                return;\r\n            }\r\n\r\n            remove();\r\n        });\r\n\r\n        $(\"div\").scroll(function () {\r\n            remove();\r\n        });\r\n\r\n        $(window).scroll(function () {\r\n            remove();\r\n        });\r\n\r\n        $(document).scroll(function () {\r\n            remove();\r\n        });\r\n\r\n        var remove = function () {\r\n            var input = $(gv_serect_input);\r\n            var container = $(gv_serect_container);\r\n\r\n            container.remove();\r\n            var select = input.parent().prev();\r\n            input.val(select.find(\"option:selected\").text());\r\n        };\r\n    };\r\n})(jQuery);"
          },
