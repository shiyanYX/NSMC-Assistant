  <a href=\"StuLeave.aspx\"><i class=\"fa fa-mail-reply\"></i>返回</a>\r\n        </div>\r\n        <div class=\"documentBody\">\r\n            <div class=\"DivTitle\">&nbsp;<img src=\"../FrameImages/arrow.gif\">&nbsp;节假日去向登记</div>\r\n            \r\n<table class=\"DivTable\" cellpadding=\"3\" cellspacing=\"1\" border=\"0\">\r\n    <tr>\r\n        <td colspan=\"4\" class=\"TitleTd\">&nbsp;节假日信息</td>\r\n    </tr>\r\n    <tr>\r\n\r\n        <td width=\"15%\" class=\"EdtTitleBack\">节假日名称：</td>\r\n        <td colspan=\"3\" class=\"EdtBack\">\r\n            \r\n            <span id=\"LeaveNoHomeConfig1_HolidayName\">2026年暑假</span>\r\n        </td>\r\n    </tr>\r\n    <tr>\r\n\r\n        <td width=\"15%\" height=\"28\" class=\"EdtTitleBack\">放假开始日期：</td>\r\n        <td width=\"35%\" class=\"EdtBack\">\r\n            <span id=\"LeaveNoHomeConfig1_BeginDate\">2026-06-25</span></td>\r\n        <td class=\"EdtTitleBack\" width=\"15%\">放假结束日期：</td>\r\n        <td width=\"35%\" class=\"EdtBack\">\r\n            <span id=\"LeaveNoHomeConfig1_EndDate\">2026-08-30</span></td>\r\n    </tr>\r\n    <tr>\r\n\r\n        <td height=\"28\" class=\"EdtTitleBack\">去向登记开始日期：</td>\r\n        <td class=\"EdtBack\">\r\n            <span id=\"LeaveNoHomeConfig1_LeaveBeginDate\">2026-06-25</span></td>\r\n        <td class=\"EdtTitleBack\" >去向登记截止日期：</td>\r\n        <td class=\"EdtBack\">\r\n            <span id=\"LeaveNoHomeConfig1_LeaveEndDate\">2026-07-20</span></td>\r\n    </tr>\r\n    <tr>\r\n        <td height=\"28\" class=\"EdtTitleBack\">备注：</td>\r\n        <td colspan=\"3\" class=\"EdtBack\">\r\n            <span id=\"LeaveNoHomeConfig1_Memo\">根据学校校历安排，2026年暑假正式放假时间为2026年7月20日至8月30日 ，因学生陆续结束教育教学活动后便离校，为了方便做好学生节假日去向登记工作，故将放假开始日期设定为2026年6月25日。</span></td>\r\n    </tr>\r\n</table>\r\n\r\n            \r\n<script src=\"../content/js/laydate/laydate.js\"></script>\r\n<table class=\"DivTable\" cellpadding=\"3\" cellspacing=\"1\" border=\"0\" onmousemove=\"getDateDiff();\">\r\n    <tr>\r\n        